<key>UIBackgroundModes</key><array><string>processing</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.voicestudio.mobile.dub-monitor</string></array>
<key>NSAppTransportSecurity</key><dict>
<key>NSAllowsLocalNetworking</key><true/>
<key>NSExceptionDomains</key><dict>
<key>ts.net</key><dict><key>NSIncludesSubdomains</key><true/><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
<key>localhost</key><dict><key>NSIncludesSubdomains</key><true/><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
</dict></dict>
</dict></plist>
